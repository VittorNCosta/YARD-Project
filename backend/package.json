{
  "name": "yardcontrol-backend",
  "version": "1.0.0",
  "description": "Yard Control Backend",
  "type": "module",
  "main": "dist/infra/server.js",
  "scripts": {
    "dev": "tsx watch src/infra/server.ts",
    "start": "tsx src/infra/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "npm run test:all",
    "lint:check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "i18next": "^26.0.6",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.3",
    "nodemailer": "^8.0.7",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "mongodb-memory-server": "^11.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
