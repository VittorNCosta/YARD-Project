# Backend environment variables (template).
# Copie para `.env` e preencha com valores reais.

# Ambiente lógico da aplicação (development | test | production)
NODE_ENV=development

# Porta HTTP (Fastify)
PORT=3000

# Connection string do MongoDB (Mongoose)
MONGO_URI=mongodb://localhost:27017/yardcontrol

# Segredos JWT — gere com: `openssl rand -hex 32` (mínimo 32 caracteres).
# Substitua os valores abaixo antes de subir qualquer ambiente.
JWT_ACCESS_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tempo de vida dos tokens (formato aceito por jsonwebtoken: "15m", "1h", "7d", ...).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Segredo usado pelo @fastify/cookie para assinar cookies (mínimo 32 caracteres).
COOKIE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Origem do frontend autorizada no CORS. Não use `*` em produção.
# IMPORTANTE: em prod use HTTPS para que o link do reset não vaze via Referer/HTTP.
FRONTEND_URL=http://localhost:5173

# ────────────────────────────────────────────────────────────────────────
# SMTP (Nodemailer) — necessário para o fluxo "Esqueci minha senha".
# Dev: use Mailtrap free tier (https://mailtrap.io/) ou Ethereal.
# Prod: use SES, SendGrid, Postmark ou SMTP corporativo.
# ────────────────────────────────────────────────────────────────────────
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=replace-with-mailtrap-user
SMTP_PASS=replace-with-mailtrap-pass
SMTP_FROM=YardControl <no-reply@yardcontrol.local>
SMTP_SECURE=false

# TTL do link de reset (5 a 60 min, default 30).
PASSWORD_RESET_TTL_MINUTES=30

# Pepper p/ HMAC-SHA-256 do token de reset.
# Gere com: openssl rand -hex 32
RESET_TOKEN_PEPPER=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hash bcrypt pré-computado p/ equalizar timing em paths anti-enumeração.
# Gere uma vez com:
#   node -e "console.log(require('bcrypt').hashSync('dummy-string-for-timing-equalization', 12))"
DUMMY_BCRYPT_HASH=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
