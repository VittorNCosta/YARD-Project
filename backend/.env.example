# Backend environment variables (template).
# Copie para `.env` e preencha com valores reais.

# Ambiente lógico da aplicação (development | test | production)
NODE_ENV=development

# Porta HTTP (Fastify)
PORT=3000

# Connection string do MongoDB (Mongoose)
MONGO_URI=mongodb://localhost:27017/yardcontrol

# Segredos JWT — gere com: `openssl rand -hex 32` (mínimo 32 caracteres).
# Substitua os valores abaixo antes de subir qualquer ambiente.
JWT_ACCESS_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tempo de vida dos tokens (formato aceito por jsonwebtoken: "15m", "1h", "7d", ...).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Segredo usado pelo @fastify/cookie para assinar cookies (mínimo 32 caracteres).
COOKIE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Origem do frontend autorizada no CORS. Não use `*` em produção.
FRONTEND_URL=http://localhost:5173
